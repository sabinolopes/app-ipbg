#!/bin/sh
# Enforces the commit rule from CLAUDE.md: "<prefix>(<scope>): <description>",
# header up to 100 characters.
header=$(head -n 1 "$1")
max_header_length=100

if ! printf '%s' "$header" | grep -Eq '^(feat|fix|chore|docs|style|refactor|perf|test)\([^)]+\): .+'; then
  echo "Commit recusado: use <prefixo>(<escopo>): <descrição>." >&2
  echo "Prefixos: feat, fix, chore, docs, style, refactor, perf, test." >&2
  echo "Exemplo: fix(lib.domains): corrige a ordenação da lista de contatos" >&2
  exit 1
fi

header_length=$(printf '%s' "$header" | wc -m | tr -d ' ')
if [ "$header_length" -gt "$max_header_length" ]; then
  echo "Commit recusado: o cabeçalho tem $header_length caracteres; o limite é $max_header_length." >&2
  exit 1
fi
